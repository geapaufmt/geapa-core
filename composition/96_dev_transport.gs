function doPost(event){const timing=f4DevReadTiming_().begin(event);let result;try{result=f4DevTransport_().post(event);}catch(e){result={error:{code:[...f4Core_().codes,'M13_AUTHZ_DENIED','VALIDATION_ERROR','INCOMPLETE_REQUEST','AUTHORIZATION_DENIED','STALE_REVISION','CONFLICT','INVALID_STATE_TRANSITION','UNRESOLVED_DEPENDENCY','HUMAN_DECISION_REQUIRED','CONFIG_CAPABILITY_DISABLED','DEADLINE_VIOLATION','SCOPE_TOO_LARGE'].includes(e.code)?e.code:'RECONCILIATION_REQUIRED'}};}const serialized=f4DevReadTiming_().stage('serialization',()=>JSON.stringify(result));f4DevReadTiming_().finish(timing,result?.error?.code||'OK');return ContentService.createTextOutput(serialized).setMimeType(ContentService.MimeType.JSON);}



